# Historical acquisitions/experiments remain intact locally. Durable stock evidence,
# reviewed application code and recovery artifacts are mirrored into named scopes.
/work/
/local/
/.cache/
/.build/
/build/
**/node_modules/
**/__pycache__/
*.py[cod]
*.o
*.obj
*.d
*.tmp
*.swp
*~

# Never version generated credentials, operator passwords or private TLS inputs.
**/private-*/
**/operator.password
**/credentials.bin
*.key
*.pem
*.p12
*.pfx
.env
.env.*
**/core
**/core.*

# Original dump copies are explicitly published under firmware/original/.
# Do not publish the complete acquisition mirrors or extracted sensitive content.

# Source-only main workflow: preserve forensic/private material locally.
# These exclusions do not remove or alter pre-existing staged entries.
/firmware/stock/
/firmware/extracted/
/evidence/photos/
/docs/archive/initial-handoff/
*.private.json
*.private.txt
*.private.bin

# Never publish generated native firmware/build images with the stock dumps.
*.UIM
*.uim
*.uImage
*.uimage
*.zimage
*.img
*.elf
*.ko
*.a
*.so
*.so.*
*.cpio
*.cpio.gz
**/zImage
**/vmlinux
**/uImage
