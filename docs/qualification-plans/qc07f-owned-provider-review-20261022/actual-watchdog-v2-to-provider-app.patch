+ *owner=(struct qc_encoder_fd_custody){.fd=*bootstrap_slot,.state=QC_ENCODER_FD_HELD,
+  .identity=*expected,.node_filesystem=node.st_dev,.node_inode=node.st_ino,.last_observed=q};
+ *bootstrap_slot=-1;
+ return QC_ENCODER_FD_OK;
+}
