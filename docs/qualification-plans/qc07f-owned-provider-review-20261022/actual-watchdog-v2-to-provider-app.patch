+  return result?result:QC_ENCODER_FD_UNCERTAIN;
+ }
+ *recipient_slot=owner->fd;
+ *owner=(struct qc_encoder_fd_custody)QC_ENCODER_FD_CUSTODY_EMPTY;
+ return QC_ENCODER_FD_OK;
+}
