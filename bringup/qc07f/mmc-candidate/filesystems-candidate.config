# Separate future candidate ONLY; NOT used by this host-object build.
# No filesystem/native write/mount/recording qualification implied.
# Review host/retirement first, then parent selects actual FS needs.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y
# CONFIG_EXT4_FS_POSIX_ACL is not set
# CONFIG_EXT4_FS_SECURITY is not set
# CONFIG_EXT4_DEBUG is not set
# Read-only mounting alone does NOT prevent ext4 journal replay; future
# authorized parent metadata work must use block-RO AND ext4 ro,noload.
